# Copy this file to .env and fill in what you want. Everything here is OPTIONAL --
# the app fully works without any of these, just with fewer features.

# --- NVIDIA NIM (AI-written rationale for high-confidence signals) ---
# Free key: https://build.nvidia.com -> profile icon -> "Get API Key"
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL=meta/llama-3.3-70b-instruct

# --- Etherscan (whale-activity watch, Ethereum-based tokens) ---
# Free key: https://etherscan.io/apis -> sign up -> create an API key
ETHERSCAN_API_KEY=

# --- Exchange API keys (READ-ONLY, market-data only -- do not enable trading or
# withdrawals). These are optional and only help with rate limits when scanning
# many symbols. Leave blank to use public (unauthenticated) endpoints. ---
BINANCE_API_KEY=
BINANCE_API_SECRET=
COINBASE_API_KEY=
COINBASE_API_SECRET=
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
